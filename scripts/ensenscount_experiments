#!/usr/bin/env python
"""
Main entry point for XGBoost Counting Experiments
Provides a unified interface to all experiment functionality
"""

import os
import sys
import subprocess
from pathlib import Path

# Add scripts directory to Python path
SCRIPT_DIR = Path(__file__).parent / "scripts"
sys.path.insert(0, str(SCRIPT_DIR))


def run_command(cmd_path, description,args=None):
    """Run a command and handle errors"""
    print(f"\n=== {description} ===")
    cmd = [sys.executable, str(cmd_path)]
    if args:
        cmd.extend(args)
    result = subprocess.run(cmd, capture_output=False)
    if result.returncode != 0:
        print(f"Error: {description} failed")
        return False
    return True


def main():
    if len(sys.argv) < 2:
        print("XGBoost Counting Experiments")
        print("=" * 50)
        print("Usage: ./ensenscount_experiments <command>")
        print("\nAvailable commands:")
        print("  prepare   - Upload code and prepare remote environment")
        print("  start     - Start experiments on remote server")
        print("  monitor   - Monitor experiment progress")
        print("  download  - Download results from remote server")
        print("  analyze   - Generate plots and analysis")
        print("  full      - Run complete workflow (prepare + start)")
        print("  clean     - Clean local results and temporary files")
        print("\nExamples:")
        print("  ./ensenscount_experiments full")
        print("  ./ensenscount_experiments prepare")
        print("  ./ensenscount_experiments analyze")
        return
    
    command = sys.argv[1].lower()
    
    # Define script paths
    experiment_scripts = SCRIPT_DIR / "experiment"
    analysis_scripts = SCRIPT_DIR / "analysis"
    
    if command == "prepare":
        success = run_command(experiment_scripts / "upload_and_prepare.py", "Preparing Remote Environment")
        if success:
            print("\n✓ Remote environment prepared!")
            print("✓ Next step: ./ensenscount_experiments start")
    
    elif command == "start":
        success = run_command(experiment_scripts / "trigger_experiments.py", "Starting Experiments")
        if success:
            print("\n✓ Experiments started!")
            print("✓ Monitor progress: ./ensenscount_experiments monitor")
            print("✓ Download results: ./ensenscount_experiments download")
    
    elif command == "monitor":
        run_command(experiment_scripts / "check_progress.py", "Monitoring Progress")
    
    elif command == "download":
        success = run_command(experiment_scripts / "download_results.py", "Downloading Results")
        if success:
            print("\n✓ Results downloaded!")
            print("✓ Generate analysis: ./ensenscount_experiments analyze")
    
    elif command == "analyze":
        extra_args = sys.argv[2:] if len(sys.argv) > 2 else []
        success = run_command(analysis_scripts / "plot_cactus.py", "Generating Analysis",args=extra_args)
        if success:
            print("\n✓ Analysis complete!")
    
    elif command == "full":
        print("Running complete experiment workflow...")
        
        # Step 1: Prepare
        if not run_command(experiment_scripts / "upload_and_prepare.py", "Preparing Remote Environment"):
            return
        
        # Step 2: Start
        if not run_command(experiment_scripts / "trigger_experiments.py", "Starting Experiments"):
            return
        
        print("\n✓ Complete workflow executed!")
        print("✓ Experiments are now running on the remote server")
        print("✓ Monitor progress: ./ensenscount_experiments monitor")
        print("✓ Download results: ./ensenscount_experiments download")
    
    elif command == "clean":
        print("Cleaning temporary files...")
        import shutil
        
        # Clean temporary files
        temp_files = ["remote_runner.sh", "__pycache__"]
        for temp in temp_files:
            if os.path.exists(temp):
                if os.path.isdir(temp):
                    shutil.rmtree(temp)
                else:
                    os.remove(temp)
                print(f"✓ Removed {temp}")
        
        print("✓ Cleanup complete!")
    
    else:
        print(f"Unknown command: {command}")
        print("Use './ensenscount_experiments' for help")


if __name__ == '__main__':
    main()
